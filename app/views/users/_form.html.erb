<% flash.each do |key, message| %>
<div class="alert alert-danger" role="alert">
  <%= message %>
</div>
<% end %>

<%
  user = @user_form.user
  form_url = user.persisted? ? user_path(user) : users_path
  form_method = user.persisted? ? :patch : :post
%>

<%= form_with(model: @user_form, url: form_url, method: form_method, local: true, html: { multipart: true }) do |form| %>
  <div data-mdb-input-init class="form-outline mb-4">
    <%= form.text_field :name, class: 'form-control', autocomplete: 'off' %>
    <%= form.label :name, class: 'form-label' %>
  </div>

  <div data-mdb-input-init class="form-outline mb-4">
    <%= form.text_field :email, class: 'form-control', autocomplete: 'off' %>
    <%= form.label :email, class: 'form-label' %>
  </div>

  <div data-mdb-input-init class="form-outline mb-4">
    <%= form.password_field :password, class: 'form-control', autocomplete: 'off' %>
    <%= form.label :password, class: 'form-label' %>
  </div>

  <div data-mdb-input-init class="form-outline mb-4">
    <%= form.select :team_id,
      options_from_collection_for_select(@teams, :id, :name, @user_form.team_id),
      { prompt: "Open this select menu" },
      { class: "form-select", "aria-label" => "Default select example" }
    %>
  </div>

  <% if current_user.super_admin? %>
    <div data-mdb-input-init class="form-outline mb-4">
      <%= form.select :role, 
        User.roles.keys.map { |r| [r.humanize, r] }, 
        { 
          prompt: "Select User Role",
          selected: @user_form.role.presence || @user_form.user.try(:role) 
        },
        
        { class: "form-select", "aria-label" => "Select Role" }
      %>
    </div>
  <% elsif @user_form.user.persisted? %>
    <%= form.hidden_field :role, value: @user_form.user.role %>
  <% end %>

  <div class="input-group mb-3">
    <%= form.file_field :avatar, class: "form-control" %>
  </div>

  <div>
    <button data-mdb-ripple-init type="submit" class="btn btn-primary btn-block mb-4">Save</button>
  </div>
<% end %>