<% content_for :style do %>
  <link href="css/sb-admin-2.min.css" rel="stylesheet">
<% end %>

<div class="container-fluid">
  <h1 class="h3 mb-2 text-gray-800">List User</h1>

  <div class="card shadow mb-4">
    <div class="card-header py-3">
    </div>
    <div class="card-body">
      <%= form_with url: users_path, method: :get, class: "d-flex" do |form| %>
        <div class="input-group mb-2">
          <%= form.text_field :title, value: params[:title], class: 'form-control rounded', placeholder: 'Search', aria: { label: 'Search' } %>
          <button class="btn btn-primary px-4" type="submit">
            <i class="fa fa-search"></i>
          </button>
        </div>
      <% end %>

      <%= link_to new_user_path, class: "d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm mb-2" do %>
        <i class="fa-solid fa-plus fa-sm text-white-50"></i>
        <span>Create</span>
      <% end %>
      <div class="table-responsive">
        <table class="table table-bordered" width="100%" cellspacing="0">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Team</th>
              <th>Avatar</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td><%= user.id %></td>
                <td><%= user.name %></td>
                <td><%= user.email %></td>
                <td>
                  <% if user.team.present? %>
                    <%= user.team.name %>
                  <% else %>
                    --
                  <% end %>
                </td>
                
                <td>
                  <% if user.persisted? && user.avatar.attached? %>
                    <%= image_tag(
                        user.avatar.variant(resize_to_limit: [180, 180]),
                        class: "card-img-top",
                        alt: user.name,
                        style: "width: 60px; object-fit: cover;"
                      )
                    %>
                  <% else %>
                    <%= image_tag(
                        "/icon.png",
                        class: "card-img-top",
                        alt: "No image available",
                        style: "width: 60px; object-fit: cover;"
                      )
                    %>
                  <% end %>
                </td>
                <td class="d-flex gap-2">
                  <%= link_to "Edit", edit_user_path(user), class: "btn btn-sm btn-primary" %>
                  <%= button_to "Delete", user_path(user), method: :delete,
                        data: { turbo_confirm: "Are you sure?" },
                        class: "btn btn-sm btn-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
